generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
}

enum BusinessCategory {
  CLINIC
  GROCERY
  RESTAURANT
  RETAIL
  GYM
  PHYSIOTHERAPY
  RENTAL
  GENERAL
}

enum InventoryChangeType {
  MANUAL_TEXT
  VOICE_NOTE
  WEB_DASHBOARD
  SALE
  RESTOCK
  ADJUSTMENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
}

enum ToolStatus {
  SUCCESS
  ERROR
}

enum ActorType {
  OWNER
  CUSTOMER
  AI
}

enum InboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ConversationWorkflowState {
  IDLE
  SELECTING_SERVICE
  SELECTING_DATE
  OFFERING_SLOTS
  COLLECTING_DETAILS
  AWAITING_CONFIRMATION
  BOOKED
  RESCHEDULING
  CANCELLING
  ESCALATION_REQUIRED
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @unique
  passwordHash  String
  name          String
  phone         String?          @unique
  phoneVerified Boolean          @default(false)
  createdAt     DateTime         @default(now())
  memberships   BusinessMember[]
}

model Business {
  id                      String           @id @default(uuid()) @db.Uuid
  slug                    String           @unique
  name                    String
  description             String           @default("")
  timezone                String           @default("Asia/Kolkata")
  cancellationPolicy      String           @default("")
  cancellationNoticeHours Int              @default(2)
  category                BusinessCategory @default(CLINIC)
  defaultLanguage         String           @default("en")
  supportedLanguages      String[]         @default(["en", "hi", "mr"])
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  members                 BusinessMember[]
  services                Service[]
  products                Product[]
  hours                   BusinessHours[]
  customers               Customer[]
  appointments            Appointment[]
  conversations           Conversation[]
  toolExecutions          ToolExecution[]
  activityLogs            ActivityLog[]
  inventoryAudits         InventoryAudit[]
}

model BusinessMember {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  businessId String     @db.Uuid
  role       MemberRole @default(OWNER)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model Service {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @db.Uuid
  name            String
  description     String        @default("")
  durationMinutes Int
  price           Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([businessId])
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @db.Uuid
  name            String
  description     String           @default("")
  sku             String?
  price           Decimal          @db.Decimal(10, 2)
  currency        String           @default("INR")
  stockQuantity   Int              @default(0)
  unit            String           @default("pcs")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryAudits InventoryAudit[]

  @@unique([businessId, sku])
  @@index([businessId, active])
  @@index([businessId, name])
}

// One open interval per weekday (0 = Sunday ... 6 = Saturday). No row = closed that day.
model BusinessHours {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  dayOfWeek  Int
  openTime   String // "HH:mm" in the business timezone
  closeTime  String // "HH:mm" in the business timezone
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  businessId    String         @db.Uuid
  name          String
  phone         String?
  email         String?
  createdAt     DateTime       @default(now())
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  conversations Conversation[]

  @@index([businessId])
  @@index([businessId, phone])
  @@index([businessId, email])
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  businessId     String            @db.Uuid
  customerId     String            @db.Uuid
  serviceId      String            @db.Uuid
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(CONFIRMED)
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer          @relation(fields: [customerId], references: [id])
  service        Service           @relation(fields: [serviceId], references: [id])

  @@index([businessId, startTime])
  @@index([customerId])
  @@index([idempotencyKey])
}

model Conversation {
  id              String                    @id @default(uuid()) @db.Uuid
  businessId      String                    @db.Uuid
  customerId      String?                   @db.Uuid
  tokenHash       String // sha256 of the secret token held by the chat client
  language        String                    @default("en")
  workflowState   ConversationWorkflowState @default(IDLE)
  pendingProposal Json?
  stateVersion    Int                       @default(0)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  business        Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer?                 @relation(fields: [customerId], references: [id])
  messages        Message[]
  toolExecutions  ToolExecution[]

  @@index([businessId, updatedAt])
  @@index([businessId, workflowState])
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  conversationId    String       @db.Uuid
  role              MessageRole
  content           String
  providerMessageId String?
  status            String?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
}

model WebhookInbox {
  id                String      @id @default(uuid()) @db.Uuid
  provider          String      @default("whatsapp")
  providerMessageId String      @unique
  eventType         String // "message" or "status"
  businessId        String?     @db.Uuid
  payload           Json
  status            InboxStatus @default(PENDING)
  attempts          Int         @default(0)
  lastError         String?
  lockedAt          DateTime?
  lockedBy          String?
  nextRetryAt       DateTime?
  processedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@index([providerMessageId])
}

model ToolExecution {
  id             String       @id @default(uuid()) @db.Uuid
  businessId     String       @db.Uuid
  conversationId String       @db.Uuid
  toolName       String
  input          Json
  result         Json
  status         ToolStatus
  createdAt      DateTime     @default(now())
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([conversationId])
}

model ActivityLog {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  actor      ActorType
  action     String
  entityType String
  entityId   String?
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model InventoryAudit {
  id               String              @id @default(uuid()) @db.Uuid
  businessId       String              @db.Uuid
  productId        String              @db.Uuid
  changeType       InventoryChangeType
  quantityDelta    Int
  previousQuantity Int
  newQuantity      Int
  previousPrice    Decimal?            @db.Decimal(10, 2)
  newPrice         Decimal?            @db.Decimal(10, 2)
  performedBy      String
  reason           String?
  idempotencyKey   String?             @unique
  createdAt        DateTime            @default(now())
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([productId, createdAt])
  @@index([idempotencyKey])
}
